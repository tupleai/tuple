{
  "title": "Tuple",
  "description": "Deploy Tuple on Google Cloud Run with Cloud SQL for PostgreSQL.",
  "logo": "https://raw.githubusercontent.com/tupleai/tuple/HEAD/.github/assets/logo-dark.png",
  "duration": 15,
  "documentationLink": "https://tuple.ai/docs",
  "variables": [
    {
      "name": "project_id",
      "prompt": "Google Cloud project ID",
      "type": "project"
    },
    {
      "name": "region",
      "prompt": "Region",
      "type": "string",
      "default": "us-central1"
    },
    {
      "name": "service_name",
      "prompt": "Cloud Run service name",
      "type": "string",
      "default": "tuple"
    },
    {
      "name": "image_url",
      "prompt": "Tuple image",
      "type": "string",
      "default": "docker.io/tupleai/tuple:6"
    },
    {
      "name": "database_tier",
      "prompt": "Cloud SQL machine tier",
      "type": "string",
      "default": "db-f1-micro"
    },
    {
      "name": "max_instances",
      "prompt": "Maximum Cloud Run instances",
      "type": "number",
      "default": 1
    },
    {
      "name": "database_deletion_protection",
      "prompt": "Enable Cloud SQL deletion protection",
      "type": "boolean",
      "default": true
    }
  ]
}
