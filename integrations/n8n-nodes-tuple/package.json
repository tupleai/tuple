{
  "name": "n8n-nodes-tuple",
  "version": "0.2.0",
  "description": "Use Tuple's OpenAI-compatible model router from n8n workflows.",
  "license": "MIT",
  "homepage": "https://tuple.ai",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tuple",
    "ai",
    "llm",
    "openai-compatible",
    "model-router"
  ],
  "author": {
    "name": "Tuple.ai",
    "email": "support@tuple.ai",
    "url": "https://tuple.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupleai/tuple.git",
    "directory": "integrations/n8n-nodes-tuple"
  },
  "bugs": {
    "url": "https://github.com/tupleai/tuple/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "npm run build && node --test",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "aiNodeSdkVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TupleApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Tuple/Tuple.node.js",
      "dist/nodes/LmChatTuple/LmChatTuple.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/ai-node-sdk": "^0.21.3",
    "@n8n/node-cli": "^0.38.7",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.0.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@n8n/ai-node-sdk": "*",
    "n8n-workflow": "*"
  },
  "overrides": {
    "@langchain/classic": {
      "uuid": "11.1.1"
    },
    "@langchain/community": {
      "uuid": "11.1.1"
    }
  }
}
